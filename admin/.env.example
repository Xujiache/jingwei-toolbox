# Public development configuration only. Do not put tokens or passwords here.
VITE_APP_NAME=经纬智能工具箱管理后台
VITE_VERSION=0.0.1
VITE_PORT=5173
VITE_BASE_URL=/
# 独立 Spring Boot 后端的 /api/v1 根地址，不包含 Token 或密码。
VITE_API_URL=http://localhost:8080/api/v1
# 可选：反向代理地址由部署环境决定，开发直连时无需使用。
VITE_API_PROXY_URL=http://localhost:8080
# 当前独立后端未提供菜单接口，使用前端静态路由并由 ADMIN 身份映射管理权限。
VITE_ACCESS_MODE=frontend
VITE_WITH_CREDENTIALS=false
