{
  "openapi": "3.1.0",
  "info": {
    "title": "经纬智能工具箱 API",
    "version": "0.1.0",
    "description": "HarmonyOS 客户端和 Vue 3 管理后台共用的接口基线。具体工具的 input/output 由工具版本契约扩展。"
  },
  "servers": [
    {
      "url": "/",
      "description": "由部署环境提供的 API 根地址"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "登录和游客会话"
    },
    {
      "name": "Me",
      "description": "当前身份"
    },
    {
      "name": "Media",
      "description": "头像等公开媒体资源"
    },
    {
      "name": "Tools",
      "description": "客户端工具目录和执行"
    },
    {
      "name": "AdminTools",
      "description": "管理后台工具和策略"
    }
  ],
  "paths": {
    "/api/v1/auth/guest-session": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "createGuestSession",
        "summary": "创建游客会话",
        "responses": {
          "200": {
            "$ref": "#/components/responses/AuthSuccess"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "register",
        "summary": "公开注册",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/AuthSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/ResourceConflict"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "login",
        "summary": "用户登录",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/AuthSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/api/v1/auth/huawei": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "loginWithHuaweiAuthorizationCode",
        "summary": "使用华为账号授权码登录或注册",
        "description": "客户端只提交一次性 authorizationCode；服务端使用部署环境中的 Client Secret 换取身份，不保存上游令牌。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HuaweiLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/AuthSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "409": {
            "$ref": "#/components/responses/ResourceConflict"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "refreshSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/AuthSuccess"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "logout",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "会话已失效"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Me"
        ],
        "operationId": "getCurrentPrincipal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "当前身份",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrincipalResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      }
    },
    "/api/v1/media/avatars/{storageKey}": {
      "get": {
        "tags": [
          "Media"
        ],
        "operationId": "getHuaweiAvatar",
        "summary": "读取服务端持久化头像",
        "parameters": [
          {
            "name": "storageKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "头像图片",
            "content": {
              "image/jpeg": {},
              "image/png": {},
              "image/gif": {},
              "image/webp": {}
            }
          },
          "404": {
            "description": "头像不存在"
          }
        }
      }
    },
    "/api/v1/tools": {
      "get": {
        "tags": [
          "Tools"
        ],
        "operationId": "listTools",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ToolStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "工具列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/{toolId}": {
      "get": {
        "tags": [
          "Tools"
        ],
        "operationId": "getTool",
        "parameters": [
          {
            "$ref": "#/components/parameters/ToolId"
          }
        ],
        "responses": {
          "200": {
            "description": "工具详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/ToolNotFound"
          }
        }
      }
    },
    "/api/v1/tools/{toolId}/execute": {
      "post": {
        "tags": [
          "Tools"
        ],
        "operationId": "executeTool",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ToolId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolExecuteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "工具执行结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolExecuteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/ToolNotFound"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          },
          "429": {
            "$ref": "#/components/responses/QuotaExceeded"
          },
          "502": {
            "$ref": "#/components/responses/DependencyError"
          },
          "501": {
            "$ref": "#/components/responses/ToolNotImplemented"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/api/v1/admin/tools": {
      "get": {
        "tags": [
          "AdminTools"
        ],
        "operationId": "adminListTools",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "后台工具列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "AdminTools"
        ],
        "operationId": "adminCreateTool",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolUpsertRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "工具已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/ResourceConflict"
          }
        }
      }
    },
    "/api/v1/admin/tools/{toolId}": {
      "patch": {
        "tags": [
          "AdminTools"
        ],
        "operationId": "adminUpdateTool",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ToolId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolPatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "工具已更新",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/ToolNotFound"
          },
          "409": {
            "$ref": "#/components/responses/ResourceConflict"
          }
        }
      }
    },
    "/api/v1/admin/tools/{toolId}/policy": {
      "patch": {
        "tags": [
          "AdminTools"
        ],
        "operationId": "adminUpdateToolPolicy",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ToolId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolPolicyPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "策略已更新",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/ToolNotFound"
          },
          "409": {
            "$ref": "#/components/responses/ResourceConflict"
          }
        }
      }
    },
    "/api/v1/admin/tools/{toolId}/versions": {
      "get": {
        "tags": [
          "AdminTools"
        ],
        "operationId": "adminListToolVersions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ToolId"
          }
        ],
        "responses": {
          "200": {
            "description": "工具版本列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolVersionListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "AdminTools"
        ],
        "operationId": "adminCreateToolVersion",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ToolId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolVersionCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "版本已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolVersionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/ResourceConflict"
          }
        }
      }
    },
    "/api/v1/admin/tools/{toolId}/versions/{version}/testing": {
      "post": {
        "tags": [
          "AdminTools"
        ],
        "operationId": "adminTestToolVersion",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ToolId"
          },
          {
            "$ref": "#/components/parameters/ToolVersionPath"
          }
        ],
        "responses": {
          "200": {
            "description": "版本已进入测试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolVersionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/admin/tools/{toolId}/versions/{version}/publish": {
      "post": {
        "tags": [
          "AdminTools"
        ],
        "operationId": "adminPublishToolVersion",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ToolId"
          },
          {
            "$ref": "#/components/parameters/ToolVersionPath"
          }
        ],
        "responses": {
          "200": {
            "description": "版本已发布",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolVersionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/ResourceConflict"
          }
        }
      }
    },
    "/api/v1/admin/tools/{toolId}/versions/{version}/rollback": {
      "post": {
        "tags": [
          "AdminTools"
        ],
        "operationId": "adminRollbackToolVersion",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ToolId"
          },
          {
            "$ref": "#/components/parameters/ToolVersionPath"
          }
        ],
        "responses": {
          "200": {
            "description": "版本已回滚",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolVersionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/ResourceConflict"
          }
        }
      }
    },
    "/api/v1/admin/tools/{toolId}/access-policy/{principalType}": {
      "get": {
        "tags": [
          "AdminTools"
        ],
        "operationId": "adminGetToolAccessPolicy",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ToolId"
          },
          {
            "$ref": "#/components/parameters/PrincipalTypePath"
          }
        ],
        "responses": {
          "200": {
            "description": "访问策略",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolAccessPolicyResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/ToolNotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "AdminTools"
        ],
        "operationId": "adminUpdateToolAccessPolicy",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ToolId"
          },
          {
            "$ref": "#/components/parameters/PrincipalTypePath"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolAccessPolicyPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "访问策略已更新",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolAccessPolicyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/ResourceConflict"
          }
        }
      }
    },
    "/api/v1/admin/tools/{toolId}/usage": {
      "get": {
        "tags": [
          "AdminTools"
        ],
        "operationId": "adminGetToolUsage",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ToolId"
          },
          {
            "$ref": "#/components/parameters/From"
          },
          {
            "$ref": "#/components/parameters/To"
          }
        ],
        "responses": {
          "200": {
            "description": "工具使用量",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/ToolNotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "ToolId": {
        "name": "toolId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "ToolVersionPath": {
        "name": "version",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        }
      },
      "PrincipalTypePath": {
        "name": "principalType",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "GUEST",
            "USER",
            "MEMBER",
            "AD_REWARDED"
          ]
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "From": {
        "name": "from",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "To": {
        "name": "to",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "identifier",
          "password"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "writeOnly": true
