# Development-only values. Never commit backend/.env or production credentials.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/jingwei_toolbox?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=jingwei
DB_PASSWORD=change-me-local-only
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
# 首次建表或本地迁移验证时置为 true
FLYWAY_ENABLED=false
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
# HS256 签名密钥：生产必须替换为 >=32 字节随机值，禁止使用下方占位值上线
JWT_SECRET=dev-only-secret-key-change-me-0123456789abcdef
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=14
GUEST_SESSION_TTL_HOURS=24
